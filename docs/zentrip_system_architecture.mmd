flowchart LR
    traveler["Customer / Admin / Partner"] -->|uses| flutter

    subgraph CLIENT["Flutter Client · Web and Mobile"]
        direction TB
        flutter["Flutter app<br/>Feature-based screens and navigation"]
        features["Feature modules<br/>Auth · Home · Flights · Hotels · Places<br/>Cars · Transfers · Trips · AI · Admin · Partner"]
        state["Feature controllers and models<br/>Normalize API data for screens"]
        api["Shared ApiService · Dio<br/>REST /api · bearer token"]
        local[("Device-local state<br/>Session · favorites · price alerts<br/>locale/currency · chat cache")]
        flutter --> features --> state --> api
        state -.->|local-only data| local
    end

    api -->|HTTPS / JSON<br/>SSE for AI chat| ingress

    subgraph SERVER["Spring Boot Backend · Java 25"]
        direction TB
        ingress["Spring Boot API<br/>/api"]
        security["Security filters<br/>Validate bearer token; resolve user and role<br/>Partner scope is server-derived"]
        controllers["REST controllers<br/>Auth · API · Partner · Admin<br/>AI chat · Preferences · Exchange rates"]
        services["Application services<br/>Inventory merge · airport/geocoding<br/>flight · hotel · attraction · maps · AI"]
        payment["Payment simulator<br/>Creates mock checkout sessions<br/>No real card charge"]
        persistence["Persistence and data access<br/>JDBC / JPA · transaction boundaries<br/>RLS runtime context"]
        ingress --> security --> controllers --> services
        controllers --> payment
        services --> persistence
        payment --> persistence
    end

    subgraph PROVIDERS["External Providers · Server-side credentials"]
        direction TB
        duffel["Duffel<br/>Flight offers only<br/>No airline order creation"]
        liteapi["LiteAPI<br/>Hotel data / rates only<br/>No provider booking"]
        otm["OpenTripMap<br/>Tourist places and details"]
        geo["Geoapify<br/>Geocoding and airport lookup"]
        serp["SerpAPI<br/>Nearby / map search"]
        requesty["Requesty<br/>AI chat completion stream"]
        frank["Frankfurter<br/>Exchange-rate lookup"]
        optional["Optional / operational<br/>Google Places sync (not configured) · OurAirports import"]
    end

    services -->|search requests| duffel
    services -->|read-only rates| liteapi
    services -->|place search / detail| otm
    services -->|geocode / airport fallback| geo
    services -->|map search| serp
    services -->|chat stream| requesty
    services -->|rates| frank
    services -.-> optional

    subgraph DATA["Persistent Data"]
        direction TB
        postgres[("Supabase PostgreSQL<br/>Accessed by backend only<br/>users · api_tokens · partners · partner_listings · offers<br/>trips · bookings · transfers · seat holds · payment_attempts<br/>tourist_monuments · landmark_places · visits<br/>ai_chat_messages · travel_preferences")]
        dataNote["Flutter does not query Supabase directly.<br/>Verify production RLS migrations and role alignment."]
        postgres --- dataNote
    end

    persistence -->|JDBC / JPA · scoped transactions| postgres
    flutter -.->|Map tiles requested directly by client| osm["OpenStreetMap tile service"]

