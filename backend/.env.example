# Supabase PostgreSQL connection details
SUPABASE_DB_URL=jdbc:postgresql://db.<YOUR_SUPABASE_PROJECT_REF>.supabase.co:5432/postgres?sslmode=require
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=replace_with_your_supabase_database_password

# Optional exact origins for cross-origin browser clients; blank disables CORS.
CORS_ALLOWED_ORIGINS=

# Backward-compatible aliases used elsewhere in the app and startup scripts
DB_URL=${SUPABASE_DB_URL}
DB_USERNAME=${SUPABASE_DB_USER}
DB_PASSWORD=${SUPABASE_DB_PASSWORD}

SERPAPI_KEY=replace_with_your_serpapi_key
GOOGLE_PLACES_API_KEY=replace_with_your_server_side_google_places_api_key
OPENTRIPMAP_API_KEY=replace_with_your_opentripmap_api_key
# Free OpenTripMap plan is non-commercial; set false only with an eligible paid plan.
OPENTRIPMAP_FREE_PLAN=true
REQUESTY_API_KEY=replace_with_your_requesty_api_key
REQUESTY_MODEL=google/gemma-4-31b-it
LITEAPI_API_KEY=replace_with_your_liteapi_api_key
LITEAPI_BASE_URL=https://api.liteapi.travel/v3.0
# ISO 3166-1 alpha-2 nationality used for hotel rate searches.
LITEAPI_GUEST_NATIONALITY=LY
MAIL_ENABLED=false
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=replace_with_your_smtp_username
SMTP_PASSWORD=replace_with_your_smtp_password
SMTP_AUTH=true
SMTP_STARTTLS=true
MAIL_FROM=no-reply@example.com
PASSWORD_RESET_HMAC_SECRET=replace_with_a_random_secret_at_least_32_characters
UPLOAD_DIR=uploads
APP_ADMIN_EMAIL=
# Existing user accounts only; format: email|company-slug|company-name|service-type
APP_PARTNER_ACCOUNTS=